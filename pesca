-- 1. Lógica Anti-AFK
local afkConnection = nil
local function antiAfkPulse()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Unknown, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Unknown, false, game)
    end)
    pcall(function()
        local position = UserInputService:GetMouseLocation()
        VirtualInputManager:SendMouseMoveEvent(position.X, position.Y, game)
    end)
    local env = (getgenv and getgenv()) or _G
    local fire = env.firesignal or env.fireSignal
    if type(fire) == "function" then
        pcall(fire, UserInputService.WindowFocused)
    end
end

ToggleAfkBtn.MouseButton1Click:Connect(function()
    instance.antiAfkEnabled = not instance.antiAfkEnabled
    ToggleAfkBtn.BackgroundColor3 = instance.antiAfkEnabled and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(220, 60, 60)
    ToggleAfkBtn.Text = "Anti-AFK: " .. (instance.antiAfkEnabled and "ON" or "OFF")

    if instance.antiAfkEnabled then
        afkConnection = LocalPlayer.Idled:Connect(antiAfkPulse)
    else
        if afkConnection then afkConnection:Disconnect() afkConnection = nil end
    end
end)

-- 2. Lógica Auto Pescar (Cast + Catch)
ToggleFishBtn.MouseButton1Click:Connect(function()
    instance.autoFishEnabled = not instance.autoFishEnabled
    ToggleFishBtn.BackgroundColor3 = instance.autoFishEnabled and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(220, 60, 60)
    ToggleFishBtn.Text = "Auto Pescar: " .. (instance.autoFishEnabled and "ON" or "OFF")
end)

if handlers then
    events:Bind("FishFightStart", function(playerName, data)
        if instance.stopped or playerName ~= LocalPlayer.Name or type(data) ~= "table" then return end

        if not instance.autoFishEnabled then
            for _, fn in pairs(originals) do
                task.spawn(fn, playerName, data)
            end
            return
        end

        instance.isFighting = true 
        local fish = data.fish
        local skills = data.skills or {}
        local pattern = (type(fish) == "table" and fish.pattern) or data.pattern

        local minTime = 0
        local success, result = pcall(fishFightInfo.MinWinSeconds, fish, skills, pattern)
        if success and type(result) == "number" then
            minTime = result
        else
            minTime = 5
        end

        local fightDelay = minTime + 0.5 + (math.random() * 1.0)

        task.delay(fightDelay, function()
            if instance.stopped or not instance.autoFishEnabled then
                instance.isFighting = false
                return
            end
            events:Fire("fishFightResult", data.id, "win", 100)
            task.wait(1)
            instance.isFighting = false
        end)
    end)
end

local lastCast = 0
table.insert(instance.connections, RunService.RenderStepped:Connect(function()
    if not instance.autoFishEnabled or instance.stopped or instance.isFighting then return end

    local fightUI = LocalPlayer.PlayerGui:FindFirstChild("FishFightUI")
    if fightUI and fightUI.Enabled then return end
    if os.clock() - lastCast < 2.5 then return end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local rayOrigin = root.CFrame * Vector3.new(0, 0, -20)
    local rayDirection = Vector3.new(0, -30, 0)
    local result = workspace:Raycast(rayOrigin, rayDirection, RaycastParams.new())
    
    if not result or result.Material ~= Enum.Material.Water then return end

    lastCast = os.clock()
    events:Fire("Fish", {
        fishingAction = "createBuoy",
        validateFishing = LocalPlayer.UserId * game.PlaceVersion * 3,
        destiny = result.Position
    })
end))

-- 3. Lógica Auto Sell (Por Tempo)
local sellConnection = nil
ToggleSellBtn.MouseButton1Click:Connect(function()
    instance.autoSellEnabled = not instance.autoSellEnabled
    ToggleSellBtn.BackgroundColor3 = instance.autoSellEnabled and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(220, 60, 60)
    ToggleSellBtn.Text = "Auto Sell ("..TEMPO_DE_VENDA.."s): " .. (instance.autoSellEnabled and "ON" or "OFF")

    if instance.autoSellEnabled then
        sellConnection = task.spawn(function()
            while instance.autoSellEnabled do
                task.wait(TEMPO_DE_VENDA)
                pcall(function()
                    RemoteEvent:FireServer("sellFish")
                end)
            end
        end)
    else
        if sellConnection then
            task.cancel(sellConnection)
            sellConnection = nil
        end
    end
end)

-- Função de Parada/Limpeza
function instance.Stop()
    if instance.stopped then return end
    instance.stopped = true
    
    if handlers then
        for guid, fn in pairs(originals) do
            handlers.FishFightStart[guid] = fn
        end
    end
    
    for _, conn in pairs(instance.connections) do
        conn:Disconnect()
    end
    if afkConnection then afkConnection:Disconnect() end
    if sellConnection then task.cancel(sellConnection) end
    
    if ScreenGui then ScreenGui:Destroy() end
    if genv.UnifiedFishHub == instance then genv.UnifiedFishHub = nil end
end

CloseButton.MouseButton1Click:Connect(instance.Stop)
genv.UnifiedFishHub = instance
