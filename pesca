-- ================================
-- CAPTURA DOS HANDLERS DO MINIGAME
-- ================================
local function getHandlers()
    local upvalues = getupvalues and getupvalues(events.Bind) or {}
    if not getupvalues then
        for i = 1, 10 do
            local ok, value = pcall(debug.getupvalue, events.Bind, i)
            if not ok then break end
            upvalues[i] = value
        end
    end
    for _, value in upvalues do
        if type(value) == "table" and type(value.FishFightStart) == "table" then
            return value
        end
    end
    return nil
end

local handlers = getHandlers()
if handlers then
    for guid, fn in pairs(handlers.FishFightStart) do
        local source = debug.info(fn, "s")
        if source == "FishFight" or source:find("%.FishFight$") then
            originals[guid] = fn
            handlers.FishFightStart[guid] = nil
        end
    end
end

